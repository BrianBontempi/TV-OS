<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Solo per caricare il sito del gioco. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/icona"
        android:label="@string/app_name"
        android:theme="@style/Gioco"
        android:usesCleartextTraffic="false">

        <!--
          configChanges: quando il controller Bluetooth si collega o si spegne cambiano "keyboard" e "navigation".
          Senza questa riga Android ricreerebbe la schermata e il gioco ripartirebbe da capo a metà partita.
        -->
        <activity
            android:name=".GiocoActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
